GOOGLE_API_KEY=your-key
GOOGLE_MODEL=gemini-3.5-flash-lite
HEADLESS=true
ARTIFACT_ROOT=/app/.runs
BROWSER_CONTAINER_MODE=false
BROWSER_PREFLIGHT_ON_STARTUP=false
BROWSER_LAUNCH_ARGS=[]
# Leave unset to auto-disable sandbox in containers and keep it enabled locally.
# BROWSER_CHROMIUM_SANDBOX=false
BROWSER_STARTUP_RETRY_COUNT=1
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
